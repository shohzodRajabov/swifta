}

enum InspectionResult {
  PASSED
  REJECTED
}

enum RemarkStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FIXED
  REINSPECTION
  ACCEPTED
}

enum AttendanceType {
  OBJECT
  WORKSHOP
  TRAVEL
  OFFICE
  IDLE_MATERIAL
  IDLE_CLIENT
  IDLE_OTHER
  ABSENT
  LEAVE
  SICK
}

enum LocationKind {
  FLOOR
  ZONE
  ROOM
  OTHER
}

enum PayrollStatus {
  OPEN
  CLOSED
}

enum ContractorKind {
  INDIVIDUAL
  BRIGADE
  COMPANY
}

enum Availability {
  AVAILABLE
  BUSY
