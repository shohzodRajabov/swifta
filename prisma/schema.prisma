// Swifta — HVAC ERP + PM + CRM
//
// Multi-tenant ready: every top-level business record carries `companyId`.
// Child records (BOM lines, payments, ...) inherit the tenant from their project.
//
// Money convention: every monetary record stores the original `amount` + `currency`,
// the exchange rate used (`fxRate` = UZS per 1 USD), the rate's date and source,
// and both normalized values `amountUzs` / `amountUsd`. Base currency is UZS.
//
// Plan / Commitment / Actual are never mixed:
//   PLAN       -> BomItem, BudgetLine, PaymentMilestone
//   COMMITMENT -> PurchaseOrder lines (not cancelled)
//   ACTUAL     -> Expense, ClientPayment, materials issued to the project (StockMovement)
//
// Material flow: BOM (plan) -> PO line (ordered) -> RECEIPT -> ISSUE to project -> CONSUMPTION (used)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SALES
  ENGINEER
  WAREHOUSE
  ACCOUNTANT
  TECHNICIAN
}

enum Currency {
  UZS
  USD
}

enum ProjectStage {
  NEW_REQUEST
  SITE_VISIT
  TECH_SPEC
  ESTIMATION
  DESIGN
  PROPOSAL
  CONTRACT
  PROCUREMENT
  WAREHOUSE
  DELIVERY
  INSTALLATION
  COMMISSIONING
  TESTING
  HANDOVER
  FINAL_PAYMENT
  WARRANTY
  SERVICE
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClientType {
  COMPANY
  GOVERNMENT
  INDIVIDUAL
  CONTRACTOR
}

enum CostCategory {
  EQUIPMENT
  MATERIAL
  LABOR
  SUBCONTRACTOR
  TRANSPORT
  TOOLS
  HOTEL
  CUSTOMS
  INSTALLATION
  OTHER
}

enum BomKind {
  EQUIPMENT
  MATERIAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum MovementType {
  RECEIPT // into a warehouse (from a PO or manual)
  ISSUE // warehouse -> project
  RETURN // project -> warehouse
  TRANSFER // warehouse -> warehouse
  ADJUSTMENT // inventory count correction (+/-)
  CONSUMPTION // used on site (does not touch warehouse stock)
}

enum PaymentMethod {
  BANK
  CASH
  CARD
  OTHER
}

model Company {
  id               String   @id @default(cuid())
  name             String
  baseCurrency     Currency @default(UZS)
  /// Notify when material usage exceeds plan by more than this percent.
  overuseThreshold Decimal  @default(5) @db.Decimal(5, 2)
  createdAt        DateTime @default(now())

  users          User[]
  clients        Client[]
  projects       Project[]
  categories     ProductCategory[]
  products       Product[]
  auditLogs      AuditLog[]
  suppliers      Supplier[]
  warehouses     Warehouse[]
  purchaseOrders PurchaseOrder[]
  movements      StockMovement[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String
  name         String
  position     String?
  phone        String?
  passwordHash String
  role         Role
  locale       String   @default("uz")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedProjects  Project[]           @relation("ProjectManager")
  engineerProjects Project[]           @relation("ProjectEngineer")
  stageEvents      ProjectStageEvent[]
  expenses         Expense[]
  auditLogs        AuditLog[]
  movements        StockMovement[]     @relation("MovementCreatedBy")
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, email])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String // create | update | delete
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
}

/// Official CBU rates cache: UZS per 1 unit of `currency`.
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(14, 4)
  source    String   @default("CBU")
  createdAt DateTime @default(now())

  @@unique([currency, date])
}

model Client {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  name          String
  type          ClientType @default(COMPANY)
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  tin           String? // STIR
  bankDetails   String?
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  projects Project[]

  @@index([companyId, name])
}

model Project {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  code           String
  name           String
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  address        String?
  contractNumber String?
  contractDate   DateTime?     @db.Date
  managerId      String?
  manager        User?         @relation("ProjectManager", fields: [managerId], references: [id])
  engineerId     String?
  engineer       User?         @relation("ProjectEngineer", fields: [engineerId], references: [id])
  installTeam    String?
  startDate      DateTime?     @db.Date
  plannedEndDate DateTime?     @db.Date
  actualEndDate  DateTime?     @db.Date
  stage          ProjectStage  @default(NEW_REQUEST)
  status         ProjectStatus @default(ACTIVE)
  priority       Priority      @default(MEDIUM)
  note           String?

  // Contract value (planned revenue)
  contractAmount    Decimal  @default(0) @db.Decimal(18, 2)
  contractCurrency  Currency @default(UZS)
  contractFxRate    Decimal  @default(1) @db.Decimal(14, 4)
  contractFxDate    DateTime @default(now()) @db.Date
  contractFxSource  String   @default("CBU")
  contractAmountUzs Decimal  @default(0) @db.Decimal(18, 2)
  contractAmountUsd Decimal  @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageEvents    ProjectStageEvent[]
  bomItems       BomItem[]
  budgetLines    BudgetLine[]
  milestones     PaymentMilestone[]
  payments       ClientPayment[]
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  movements      StockMovement[]

  @@unique([companyId, code])
  @@index([companyId, stage])
}

model ProjectStageEvent {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage
  enteredAt DateTime     @default(now())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  note      String?

  @@index([projectId, enteredAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  key       String? // system category key, translated in UI
  name      String
  kind      BomKind   @default(MATERIAL)
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([companyId, name])
}

model Product {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  sku              String
  name             String
  manufacturer     String?
  model            String?
  categoryId       String
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  unit             String
  purchasePrice    Decimal         @default(0) @db.Decimal(18, 2)
  purchaseCurrency Currency        @default(UZS)
  salePrice        Decimal         @default(0) @db.Decimal(18, 2)
  saleCurrency     Currency        @default(UZS)
  supplier         String?
  minStock         Decimal         @default(0) @db.Decimal(14, 3)
  description      String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  bomItems  BomItem[]
  prices    SupplierPrice[]
  poLines   PurchaseOrderLine[]
  movements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, name])
}

/// PLAN: material/equipment specification line of a project.
model BomItem {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  kind       BomKind  @default(MATERIAL)
  name       String
  unit       String
  plannedQty Decimal  @db.Decimal(14, 3)
  sortOrder  Int      @default(0)

  unitPrice      Decimal  @db.Decimal(18, 2)
  currency       Currency @default(UZS)
  fxRate         Decimal  @db.Decimal(14, 4)
  fxDate         DateTime @db.Date
  fxSource       String   @default("CBU")
  unitPriceUzs   Decimal  @db.Decimal(18, 2)
  plannedCostUzs Decimal  @db.Decimal(18, 2)
  plannedCostUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poLines   PurchaseOrderLine[]
  movements StockMovement[]

  @@index([projectId])
}

/// PLAN: non-BOM planned costs (labour, transport, hotel, ...).
model BudgetLine {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// PLAN: client payment schedule.
model PaymentMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  percent   Decimal   @db.Decimal(6, 2)
  dueDate   DateTime? @db.Date
  sortOrder Int       @default(0)

  amountUzs Decimal @db.Decimal(18, 2)
  amountUsd Decimal @db.Decimal(18, 2)

  payments ClientPayment[]

  @@index([projectId])
}

/// ACTUAL: money received from the client.
model ClientPayment {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   PaymentMilestone? @relation(fields: [milestoneId], references: [id])
  date        DateTime          @db.Date
  method      PaymentMethod     @default(BANK)
  reference   String?
  note        String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([projectId, date])
}

/// ACTUAL: money spent. Always bound to a project.
model Expense {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category    CostCategory
  date        DateTime     @db.Date
  description String
  supplier    String?
  reference   String?
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
  @@index([category])
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  tin           String?
  bankDetails   String?
  paymentTerms  String?
  leadTimeDays  Int?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices         SupplierPrice[]
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([companyId, name])
}

/// Supplier quote / price list entry, used for price comparison.
model SupplierPrice {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price        Decimal  @db.Decimal(18, 2)
  currency     Currency @default(UZS)
  priceUzs     Decimal  @db.Decimal(18, 2)
  priceUsd     Decimal  @db.Decimal(18, 2)
  fxRate       Decimal  @db.Decimal(14, 4)
  date         DateTime @db.Date
  leadTimeDays Int?
  note         String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  active    Boolean @default(true)

  purchaseOrders PurchaseOrder[]
  movementsFrom  StockMovement[] @relation("MovementFrom")
  movementsTo    StockMovement[] @relation("MovementTo")

  @@unique([companyId, name])
}

/// COMMITMENT: an order placed with a supplier.
model PurchaseOrder {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  number         String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id])
  warehouseId    String
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @db.Date
  expectedDate   DateTime?           @db.Date
  paymentDueDate DateTime?           @db.Date
  invoiceNumber  String?
  note           String?
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])

  // Order-level currency and rate; line amounts use the same rate.
  currency    Currency @default(UZS)
  fxRate      Decimal  @db.Decimal(14, 4)
  fxDate      DateTime @db.Date
  fxSource    String   @default("CBU")
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  totalUzs    Decimal  @default(0) @db.Decimal(18, 2)
  totalUsd    Decimal  @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    PurchaseOrderLine[]
  payments SupplierPayment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([projectId])
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  bomItemId String?
  bomItem   BomItem?      @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  name      String
  unit      String
  qty       Decimal       @db.Decimal(14, 3)
  unitPrice Decimal       @db.Decimal(18, 2)
  amount    Decimal       @db.Decimal(18, 2)
  amountUzs Decimal       @db.Decimal(18, 2)
  amountUsd Decimal       @db.Decimal(18, 2)
  sortOrder Int           @default(0)

  movements StockMovement[]

  @@index([orderId])
}

/// Every warehouse / material event. Quantities are always positive; the type gives the direction
/// (ADJUSTMENT uses a signed qty).
model StockMovement {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  type          MovementType
  date          DateTime           @db.Date
  productId     String?
  product       Product?           @relation(fields: [productId], references: [id])
  bomItemId     String?
  bomItem       BomItem?           @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  name          String
  unit          String
  qty           Decimal            @db.Decimal(14, 3)
  warehouseId   String?
  warehouse     Warehouse?         @relation("MovementFrom", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?         @relation("MovementTo", fields: [toWarehouseId], references: [id])
  projectId     String?
  project       Project?           @relation(fields: [projectId], references: [id])
  poLineId      String?
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  /// Cost per unit at the time of the movement (for valuation and project actual cost).
  unitCostUzs   Decimal            @default(0) @db.Decimal(18, 2)
  unitCostUsd   Decimal            @default(0) @db.Decimal(18, 4)
  responsible   String?
  document      String?
  note          String?
  createdById   String?
  createdBy     User?              @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())

  @@index([companyId, type, date])
  @@index([projectId])
  @@index([productId])
  @@index([warehouseId])
}

/// Money paid to a supplier (reduces payables).
model SupplierPayment {
  id         String         @id @default(cuid())
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  orderId    String?
  order      PurchaseOrder? @relation(fields: [orderId], references: [id])
  date       DateTime       @db.Date
  method     PaymentMethod  @default(BANK)
  reference  String?
  note       String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([supplierId, date])
}
