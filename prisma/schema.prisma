// Swifta — HVAC ERP + PM + CRM
//
// Multi-tenant ready: every top-level business record carries `companyId`.
// Child records (BOM lines, payments, ...) inherit the tenant from their project.
//
// Money convention: every monetary record stores the original `amount` + `currency`,
// the exchange rate used (`fxRate` = UZS per 1 USD), the rate's date and source,
// and both normalized values `amountUzs` / `amountUsd`. Base currency is UZS.
//
// VAT: amounts are entered gross (as on the invoice) together with `vatRate` (0 = no VAT).
// Net = gross * 100 / (100 + vatRate). Profit uses net values for legal entities under the general tax regime.
//
// Plan / Forecast / Actual are never mixed (see docs/KONSEPT.md):
//   PLAN       -> contract (+ amendments), BomItem, BudgetLine, PaymentMilestone, planned task costs
//   COMMITMENT -> purchase orders and contractor agreements not yet delivered (feeds the forecast)
//   ACTUAL     -> signed acts (revenue), approved expenses, issued materials, approved work sessions (labour),
//                 verified contractor work
//
// Material flow: BOM (plan) -> PO line (ordered) -> RECEIPT -> ISSUE to project -> CONSUMPTION (used)
// Work flow: Task -> WorkSession (physical quantity, recorded once) -> members (hours, share, contribution)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SALES
  ENGINEER
  WAREHOUSE
  ACCOUNTANT
  TECHNICIAN
}

enum Currency {
  UZS
  USD
}

enum ProjectStage {
  NEW_REQUEST
  SITE_VISIT
  TECH_SPEC
  ESTIMATION
  DESIGN
  PROPOSAL
  CONTRACT
  PROCUREMENT
  WAREHOUSE
  DELIVERY
  INSTALLATION
  COMMISSIONING
  TESTING
  HANDOVER
  FINAL_PAYMENT
  WARRANTY
  SERVICE
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClientType {
  COMPANY
  GOVERNMENT
  INDIVIDUAL
  CONTRACTOR
}

enum CostCategory {
  EQUIPMENT
  MATERIAL
  LABOR // internal labour
  OUTSOURCING // external masters / brigades per task
  SUBCONTRACTOR // firms taking a scope under contract
  TRANSPORT
  WAREHOUSE
  TOOLS
  HOTEL
  CUSTOMS
  INSTALLATION
  TAX // turnover tax on revenue (turnover regime)
  OTHER
}

enum BomKind {
  EQUIPMENT
  MATERIAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum MovementType {
  RECEIPT // into a warehouse (from a PO or manual)
  ISSUE // warehouse -> project
  RETURN // project -> warehouse
  TRANSFER // warehouse -> warehouse
  ADJUSTMENT // inventory count correction (+/-)
  CONSUMPTION // used on site (does not touch warehouse stock)
}

enum StatusGroupCode {
  NEW
  OFFER
  CONTRACT
  WORK
  TESTING
  LAUNCHED
  DONE
  SERVICE
}

enum TaxRegime {
  GENERAL // VAT + profit tax
  TURNOVER // turnover tax, no VAT
}

enum SalaryInputMode {
  NET // "qo'lga" — after income tax
  GROSS
}

enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum DocumentCategory {
  CONTRACT
  SIGNED_CONTRACT
  ADDITIONAL_AGREEMENT
  COMMERCIAL_OFFER
  TECH_SPEC
  PROJECT_FILES
  DRAWING
  SPECIFICATION
  SMETA
  INVOICE
  PURCHASE_ORDER
  WAYBILL
  ACT
  COMPLETION_ACT
  HIDDEN_WORKS_ACT
  TEST_ACT
  PAYMENT_PROOF
  FINAL_DOCS
  WARRANTY
  PASSPORT
  CERTIFICATE
  PHOTO
  CORRESPONDENCE
  SERVICE_REPORT
  CONTRACTOR_DOC
  OTHER
}

enum ActStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum OverheadCategory {
  OFFICE_RENT
  OFFICE_SALARY
  PAYROLL_UNALLOCATED
  VEHICLE
  FUEL
  UTILITIES
  COMMUNICATION
  MARKETING
  BANK_FEES
  TAXES_FEES
  TOOLS
  WORKSHOP
  OTHER
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum GroupRole {
  LEADER
  SENIOR
  WORKER
}

enum TaskStatus {
  NEW
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  INSPECTION
  APPROVED
  REJECTED
  REWORK
  BLOCKED
  CANCELLED
}

enum AssigneeKind {
