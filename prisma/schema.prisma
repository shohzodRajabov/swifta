  APPROVED
}

enum ZoneKind {
  POINT
  LINE
  RECT
  POLYGON
}

enum ImportStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ServiceTicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum ServiceFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ON_CALL
}

enum ServiceContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  BANK
  CASH
  CARD
  OTHER
}

model Company {
  id               String   @id @default(cuid())
  name             String
  baseCurrency     Currency @default(UZS)
  /// Notify when material usage exceeds plan by more than this percent.
  overuseThreshold Decimal  @default(5) @db.Decimal(5, 2)
  /// Demo workspace: never mixed with real data.
  isDemo           Boolean  @default(false)
  /// Version of the generated demo data; the demo is rebuilt when the code ships a newer version.
  demoVersion      Int      @default(0)

  // Payroll & taxes
  normWorkDays    Int             @default(22)
  normHoursPerDay Decimal         @default(8) @db.Decimal(4, 2)
  salaryInputMode SalaryInputMode @default(NET)
  incomeTaxRate   Decimal         @default(12) @db.Decimal(5, 2)
  socialTaxRate   Decimal         @default(12) @db.Decimal(5, 2)

  // Finance controls
  approvalThresholdUzs Decimal @default(10000000) @db.Decimal(18, 2)

  // Workforce
  /// Weights by group role for the RULE contribution method, e.g. {"LEADER":1.2,"SENIOR":1.1,"WORKER":1}
  contributionWeights   Json?
  defaultContribution   ContributionMethod @default(EQUAL)
  efficiencyMinSessions Int                @default(5)
  /// Hours above the norm in one day are paid (and charged to projects) with this multiplier.
  overtimeMultiplier    Decimal            @default(1.5) @db.Decimal(4, 2)
  /// Upper limit of hours a person can be recorded for in one day.
  maxDailyHours         Int                @default(14)

  // Contractors: configurable formulas (component -> weight)
  contractorRatingConfig      Json?
  contractorReliabilityConfig Json?
  contractorPhoneRequired     Boolean @default(true)

  // Security
  /// Administrators must use two-factor authentication.
  require2faForAdmins Boolean @default(false)

  // KPI bonus: [{min: score, pct: % of the monthly salary}], applied when an employee KPI month is approved
  kpiBonusEnabled Boolean @default(false)
  kpiBonusScale   Json?

  // AI translation of user-entered texts
  /// NONE | GEMINI | ANTHROPIC
  aiProvider      String  @default("NONE")
  /// API key, encrypted with ENCRYPTION_KEY ("enc:..."); entered by an administrator.
  aiApiKey        String?
  aiModel         String?
  aiAutoTranslate Boolean @default(false)

  // Telegram digest
  telegramBotToken     String?
  telegramChatId       String?
  telegramDigestHour   Int       @default(19)
  telegramLastDigestAt DateTime?

  createdAt DateTime @default(now())

  users            User[]
  roles            RoleDef[]
  legalEntities    LegalEntity[]
  statusGroups     StatusGroup[]
  files            FileObject[]
  documents        Document[]
  overheads        OverheadExpense[]
  employees        Employee[]
  groups           WorkGroup[]
  workTypes        WorkType[]
  tasks            Task[]
  sessions         WorkSession[]
  remarks          Remark[]
  attendance       AttendanceDay[]
  payrollMonths    PayrollMonth[]
  smetaImports     SmetaImport[]
  contractors      Contractor[]
  kpiRules         KpiRule[]
  kpiPeriods       KpiPeriod[]
  drawings         Drawing[]
  serviceContracts ServiceContract[]
  serviceTickets   ServiceTicket[]
  clients          Client[]
  projects         Project[]
  categories       ProductCategory[]
  products         Product[]
  auditLogs        AuditLog[]
  suppliers        Supplier[]
  warehouses       Warehouse[]
  purchaseOrders   PurchaseOrder[]
  movements        StockMovement[]
  translations     TextTranslation[]
}

model User {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  email              String?
  name               String
  position           String?
  /// Login phone, normalized to digits with country code (998XXXXXXXXX).
  phone              String?
  passwordHash       String
  /// Deprecated: replaced by `roleId` (kept for data safety).
  role               Role?
  roleId             String?
  roleDef            RoleDef?  @relation(fields: [roleId], references: [id])
  /// Set when an admin issues a one-time password; the user must choose their own on next login.
  mustChangePassword Boolean   @default(false)
  /// Bumped on password change / reset / "sign out everywhere": older session tokens stop working.
  sessionVersion     Int       @default(0)
  /// A one-time password stops working after this moment (X7).
  otpExpiresAt       DateTime?
  /// Two-factor authentication (TOTP, authenticator app): secret is stored encrypted ("enc:..."), X9.
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  lastLoginAt        DateTime?
  locale             String    @default("uz")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee           Employee?
  managedProjects    Project[]           @relation("ProjectManager")
  engineerProjects   Project[]           @relation("ProjectEngineer")
  chiefProjects      Project[]           @relation("ProjectChiefEngineer")
  foremanProjects    Project[]           @relation("ProjectForeman")
  stageEvents        ProjectStageEvent[]
  expenses           Expense[]           @relation("ExpenseCreatedBy")
  auditLogs          AuditLog[]
  movements          StockMovement[]     @relation("MovementCreatedBy")
  purchaseOrders     PurchaseOrder[]
  uploadedFiles      FileObject[]
  responsibleTasks   Task[]              @relation("TaskResponsible")
  inspectorTasks     Task[]              @relation("TaskInspector")
  approverTasks      Task[]              @relation("TaskApprover")
  createdTasks       Task[]              @relation("TaskCreatedBy")
  taskEvents         TaskEvent[]
  recordedSessions   WorkSession[]       @relation("SessionRecordedBy")
  approvedSessions   WorkSession[]       @relation("SessionApprovedBy")
  inspections        Inspection[]
  responsibleRemarks Remark[]            @relation("RemarkResponsible")
  createdRemarks     Remark[]            @relation("RemarkCreatedBy")
  serviceTickets     ServiceTicket[]

  @@unique([companyId, email])
  @@unique([companyId, phone])
}

/// Admin-configurable role: a named set of permissions (see src/lib/permissions.ts).
model RoleDef {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  /// System key for built-in roles (ADMIN, DIRECTOR, ...); null for custom roles.
  key         String?
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users User[]

  @@unique([companyId, name])
  @@unique([companyId, key])
}

/// Our own legal entities that sign contracts with customers.
model LegalEntity {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  name            String
  tin             String?
  address         String?
  bankDetails     String?
  director        String?
  phone           String?
  taxRegime       TaxRegime @default(GENERAL)
  vatRate         Decimal   @default(12) @db.Decimal(5, 2)
  turnoverTaxRate Decimal   @default(4) @db.Decimal(5, 2)
  profitTaxRate   Decimal   @default(15) @db.Decimal(5, 2)
  isDefault       Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  projects  Project[]
  overheads OverheadExpense[]

  @@unique([companyId, name])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String // create | update | delete
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
}

/// Official CBU rates cache: UZS per 1 unit of `currency`.
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(14, 4)
  source    String   @default("CBU")
  createdAt DateTime @default(now())

  @@unique([currency, date])
}

model Client {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  name          String
  type          ClientType @default(COMPANY)
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  tin           String? // STIR
  bankDetails   String?
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  projects         Project[]         @relation("ProjectCustomer")
  ownedProjects    Project[]         @relation("ProjectOwner")
  serviceContracts ServiceContract[]
  serviceTickets   ServiceTicket[]

  @@index([companyId, name])
}

model Project {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  code             String
  name             String
  /// Customer / general contractor: signs the contract with us and pays us.
  clientId         String
  client           Client        @relation("ProjectCustomer", fields: [clientId], references: [id])
  /// Owner of the object (e.g. a bank); may equal the customer.
  ownerId          String?
  owner            Client?       @relation("ProjectOwner", fields: [ownerId], references: [id])
  /// Which of our legal entities signs the contract.
  legalEntityId    String?
  legalEntity      LegalEntity?  @relation(fields: [legalEntityId], references: [id])
  objectType       String?
  siteContactName  String?
  siteContactPhone String?
  siteContactEmail String?
  address          String?
  contractNumber   String?
  contractDate     DateTime?     @db.Date
  managerId        String?
  manager          User?         @relation("ProjectManager", fields: [managerId], references: [id])
  engineerId       String?
  engineer         User?         @relation("ProjectEngineer", fields: [engineerId], references: [id])
  chiefEngineerId  String?
  chiefEngineer    User?         @relation("ProjectChiefEngineer", fields: [chiefEngineerId], references: [id])
  foremanId        String?
  foreman          User?         @relation("ProjectForeman", fields: [foremanId], references: [id])
  installTeam      String?
  startDate        DateTime?     @db.Date
  plannedEndDate   DateTime?     @db.Date
  actualEndDate    DateTime?     @db.Date
  /// Deprecated: replaced by `statusId` (admin-configurable statuses).
  stage            ProjectStage  @default(NEW_REQUEST)
  statusId         String?
  statusDef        StatusDef?    @relation(fields: [statusId], references: [id])
  status           ProjectStatus @default(ACTIVE)
  warrantyMonths   Int?
  warrantyStart    DateTime?     @db.Date
  warrantyEnd      DateTime?     @db.Date
  priority         Priority      @default(MEDIUM)
  note             String?

  // Contract value (planned revenue)
  contractAmount    Decimal  @default(0) @db.Decimal(18, 2)
  contractCurrency  Currency @default(UZS)
  contractFxRate    Decimal  @default(1) @db.Decimal(14, 4)
  contractFxDate    DateTime @default(now()) @db.Date
  contractFxSource  String   @default("CBU")
  contractAmountUzs Decimal  @default(0) @db.Decimal(18, 2)
  contractAmountUsd Decimal  @default(0) @db.Decimal(18, 2)
  contractVatRate   Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageEvents        ProjectStageEvent[]
  amendments         ContractAmendment[]
  acts               Act[]
  documents          Document[]
  locations          ProjectLocation[]
  tasks              Task[]
  sessions           WorkSession[]
  remarks            Remark[]
  attendance         AttendanceDay[]
  smetaImports       SmetaImport[]
  contractorPayments ContractorPayment[]
  drawings           Drawing[]
  serviceContracts   ServiceContract[]
  serviceTickets     ServiceTicket[]
  bomItems           BomItem[]
  budgetLines        BudgetLine[]
  milestones         PaymentMilestone[]
  payments           ClientPayment[]
  expenses           Expense[]
  purchaseOrders     PurchaseOrder[]
  movements          StockMovement[]

  @@unique([companyId, code])
  @@index([companyId, stage])
}

model ProjectStageEvent {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Deprecated (old fixed stages); new events use `statusId`.
  stage     ProjectStage?
  statusId  String?
  statusDef StatusDef?    @relation(fields: [statusId], references: [id])
  enteredAt DateTime      @default(now())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  note      String?

  @@index([projectId, enteredAt])
}

model ProductCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  key       String? // system category key, translated in UI
  name      String
  kind      BomKind   @default(MATERIAL)
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([companyId, name])
}

model Product {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  sku              String
  name             String
  manufacturer     String?
  model            String?
  categoryId       String
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  unit             String
  purchasePrice    Decimal         @default(0) @db.Decimal(18, 2)
  purchaseCurrency Currency        @default(UZS)
  salePrice        Decimal         @default(0) @db.Decimal(18, 2)
  saleCurrency     Currency        @default(UZS)
  supplier         String?
  minStock         Decimal         @default(0) @db.Decimal(14, 3)
  description      String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  bomItems  BomItem[]
  prices    SupplierPrice[]
  poLines   PurchaseOrderLine[]
  movements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, name])
}

/// PLAN: material/equipment specification line of a project.
model BomItem {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  kind       BomKind  @default(MATERIAL)
  name       String
  unit       String
  plannedQty Decimal  @db.Decimal(14, 3)
  sortOrder  Int      @default(0)

  unitPrice      Decimal  @db.Decimal(18, 2)
  currency       Currency @default(UZS)
  fxRate         Decimal  @db.Decimal(14, 4)
  fxDate         DateTime @db.Date
  fxSource       String   @default("CBU")
  unitPriceUzs   Decimal  @db.Decimal(18, 2)
  plannedCostUzs Decimal  @db.Decimal(18, 2)
  plannedCostUsd Decimal  @db.Decimal(18, 2)
  vatRate        Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poLines   PurchaseOrderLine[]
  movements StockMovement[]
  tasks     Task[]

  @@index([projectId])
}

/// PLAN: non-BOM planned costs (labour, transport, hotel, ...).
model BudgetLine {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  description String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// PLAN: client payment schedule.
model PaymentMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  percent   Decimal   @db.Decimal(6, 2)
  dueDate   DateTime? @db.Date
  sortOrder Int       @default(0)

  amountUzs Decimal @db.Decimal(18, 2)
  amountUsd Decimal @db.Decimal(18, 2)

  payments ClientPayment[]

  @@index([projectId])
}

/// ACTUAL: money received from the client.
model ClientPayment {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   PaymentMilestone? @relation(fields: [milestoneId], references: [id])
  date        DateTime          @db.Date
  method      PaymentMethod     @default(BANK)
  reference   String?
  note        String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([projectId, date])
}

/// ACTUAL: money spent. Always bound to a project.
model Expense {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category    CostCategory
  date        DateTime     @db.Date
  description String
  supplier    String?
  reference   String?
  createdById String?
  createdBy   User?        @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  approval     ApprovalStatus @default(APPROVED)
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, date])
  @@index([category])
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  tin           String?
  bankDetails   String?
  paymentTerms  String?
  leadTimeDays  Int?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices         SupplierPrice[]
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([companyId, name])
}

/// Supplier quote / price list entry, used for price comparison.
model SupplierPrice {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price        Decimal  @db.Decimal(18, 2)
  currency     Currency @default(UZS)
  priceUzs     Decimal  @db.Decimal(18, 2)
  priceUsd     Decimal  @db.Decimal(18, 2)
  fxRate       Decimal  @db.Decimal(14, 4)
  date         DateTime @db.Date
  leadTimeDays Int?
  note         String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([supplierId])
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  active    Boolean @default(true)

  purchaseOrders PurchaseOrder[]
  movementsFrom  StockMovement[] @relation("MovementFrom")
  movementsTo    StockMovement[] @relation("MovementTo")

  @@unique([companyId, name])
}

/// COMMITMENT: an order placed with a supplier.
model PurchaseOrder {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  number         String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id])
  warehouseId    String
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @db.Date
  expectedDate   DateTime?           @db.Date
  paymentDueDate DateTime?           @db.Date
  invoiceNumber  String?
  note           String?
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])

  // Order-level currency and rate; line amounts use the same rate.
  currency    Currency @default(UZS)
  fxRate      Decimal  @db.Decimal(14, 4)
  fxDate      DateTime @db.Date
  fxSource    String   @default("CBU")
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  totalUzs    Decimal  @default(0) @db.Decimal(18, 2)
  totalUsd    Decimal  @default(0) @db.Decimal(18, 2)
  vatRate     Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    PurchaseOrderLine[]
  payments SupplierPayment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([projectId])
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  bomItemId String?
  bomItem   BomItem?      @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  name      String
  unit      String
  qty       Decimal       @db.Decimal(14, 3)
  unitPrice Decimal       @db.Decimal(18, 2)
  amount    Decimal       @db.Decimal(18, 2)
  amountUzs Decimal       @db.Decimal(18, 2)
  amountUsd Decimal       @db.Decimal(18, 2)
  sortOrder Int           @default(0)

  movements StockMovement[]

  @@index([orderId])
}

/// Every warehouse / material event. Quantities are always positive; the type gives the direction
/// (ADJUSTMENT uses a signed qty).
model StockMovement {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  type            MovementType
  date            DateTime           @db.Date
  productId       String?
  product         Product?           @relation(fields: [productId], references: [id])
  bomItemId       String?
  bomItem         BomItem?           @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  name            String
  unit            String
  qty             Decimal            @db.Decimal(14, 3)
  warehouseId     String?
  warehouse       Warehouse?         @relation("MovementFrom", fields: [warehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?         @relation("MovementTo", fields: [toWarehouseId], references: [id])
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id])
  poLineId        String?
  poLine          PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  /// Cost per unit at the time of the movement (for valuation and project actual cost), gross and net of VAT.
  unitCostUzs     Decimal            @default(0) @db.Decimal(18, 2)
  unitCostUsd     Decimal            @default(0) @db.Decimal(18, 4)
  unitCostNetUzs  Decimal            @default(0) @db.Decimal(18, 2)
  unitCostNetUsd  Decimal            @default(0) @db.Decimal(18, 4)
  vatRate         Decimal            @default(0) @db.Decimal(5, 2)
  /// Material use recorded against a task / work session / service ticket.
  taskId          String?
  task            Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sessionId       String?
  session         WorkSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  serviceTicketId String?
  serviceTicket   ServiceTicket?     @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  responsible     String?
  document        String?
  note            String?
  createdById     String?
  createdBy       User?              @relation("MovementCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([companyId, type, date])
  @@index([projectId])
  @@index([productId])
  @@index([warehouseId])
}

/// Money paid to a supplier (reduces payables).
model SupplierPayment {
  id         String         @id @default(cuid())
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  orderId    String?
  order      PurchaseOrder? @relation(fields: [orderId], references: [id])
  date       DateTime       @db.Date
  method     PaymentMethod  @default(BANK)
  reference  String?
  note       String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  approval     ApprovalStatus @default(APPROVED)
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([supplierId, date])
}

// =====================================================================================
// Statuses (admin-configurable), documents, contract revenue, overhead, backups
// =====================================================================================

/// Fixed status groups A–H; the `code` drives business logic, the name/colour are editable.
model StatusGroup {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  code      StatusGroupCode
  letter    String
  name      String
  color     String          @default("#64748b")
  sortOrder Int             @default(0)

  statuses StatusDef[]

  @@unique([companyId, code])
}

model StatusDef {
  id           String             @id @default(cuid())
  groupId      String
  group        StatusGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code         String
  name         String
  sortOrder    Int                @default(0)
  active       Boolean            @default(true)
  /// Document categories that must exist on the project before entering this status.
  requiredDocs DocumentCategory[]

  projects Project[]
  events   ProjectStageEvent[]

  @@unique([groupId, code])
}

/// A stored file (local disk in development, S3 bucket in production).
model FileObject {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  storageKey   String   @unique
  fileName     String
  mime         String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  versions        DocumentVersion[]
  attachments     Attachment[]
  drawingVersions DrawingVersion[]
  smetaImports    SmetaImport[]
}

/// A managed document with immutable versions (v1, v2, ...).
model Document {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id])
  contractorId String?
  contractor   Contractor?      @relation(fields: [contractorId], references: [id])
  category     DocumentCategory
  title        String
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  versions DocumentVersion[]
  acts     Act[]

  @@index([companyId, projectId, category])
}

model DocumentVersion {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  fileId      String
  file        FileObject @relation(fields: [fileId], references: [id])
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([documentId, version])
}

/// Photos / files attached to a record (task, session, remark, expense, ticket ...).
model Attachment {
  id         String     @id @default(cuid())
  companyId  String
  fileId     String
  file       FileObject @relation(fields: [fileId], references: [id])
  entityType String
  entityId   String
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}

/// Additional agreement that changes the contract value (e.g. extra works).
model ContractAmendment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      String
  date        DateTime @db.Date
  description String

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

/// ACTUAL revenue: act of completed works (Forma 2/3), interim or final.
model Act {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     String
  date       DateTime  @db.Date
  periodFrom DateTime? @db.Date
  periodTo   DateTime? @db.Date
  status     ActStatus @default(DRAFT)
  signedAt   DateTime?
  note       String?
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines ActLine[]

  @@index([projectId, date])
}

model ActLine {
  id          String  @id @default(cuid())
  actId       String
  act         Act     @relation(fields: [actId], references: [id], onDelete: Cascade)
  taskId      String?
  description String
  qty         Decimal @db.Decimal(14, 3)
  unit        String
  amountUzs   Decimal @db.Decimal(18, 2)
}

/// Company-level costs not tied to a project (office, vehicles, unallocated payroll ...).
model OverheadExpense {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  legalEntityId  String?
  legalEntity    LegalEntity?     @relation(fields: [legalEntityId], references: [id])
  category       OverheadCategory
  date           DateTime         @db.Date
  description    String
  supplier       String?
  reference      String?
  /// MANUAL or PAYROLL (generated when a payroll month is closed)
  source         String           @default("MANUAL")
  payrollMonthId String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  approval     ApprovalStatus @default(APPROVED)
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, date])
}

/// Database backups (pg_dump to object storage). Not tenant-scoped.
model BackupRun {
  id          String       @id @default(cuid())
  trigger     String // SCHEDULE | MANUAL
  status      BackupStatus @default(RUNNING)
  storageKey  String?
  sizeBytes   Int?
  error       String?
  createdById String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
}

// =====================================================================================
// Workforce: employees, groups (with history), tasks, work sessions, inspections, remarks
// =====================================================================================

model Employee {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  fullName   String
  phone      String?
  position   String?
  department String?
  /// Monthly salary as entered (net "qo'lga" or gross — see Company.salaryInputMode), UZS.
  salary     Decimal   @default(0) @db.Decimal(18, 2)
  /// Overrides Company.normWorkDays for this employee.
  normDays   Int?
  hireDate   DateTime? @db.Date
  /// Passport series and number (personal data: visible only with employees.edit); scans are attachments
  /// with entityType "employee_passport".
  passportNumber String?
  active     Boolean   @default(true)
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id])
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    GroupMember[]
  assignments    TaskAssignment[]
  sessionsLed    WorkSession[]       @relation("SessionLeader")
  sessionMembers WorkSessionMember[]
  taskEvents     TaskEvent[]
  attendance     AttendanceDay[]
  payrollLines   PayrollLine[]
  kpiSnapshots   KpiSnapshot[]

  @@index([companyId, fullName])
}

model WorkGroup {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  specialization String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  members      GroupMember[]
  assignments  TaskAssignment[]
  sessions     WorkSession[]
  kpiSnapshots KpiSnapshot[]

  @@unique([companyId, name])
}

/// Group composition with history: membership is valid from `fromDate` until `toDate` (inclusive), open if null.
model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  group      WorkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  role       GroupRole @default(WORKER)
  fromDate   DateTime  @db.Date
  toDate     DateTime? @db.Date
  createdAt  DateTime  @default(now())

  @@index([groupId, fromDate])
  @@index([employeeId])
}

model WorkType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  unit      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  tasks Task[]

  @@unique([companyId, name])
}

/// Floor / zone / room tree of a project.
model ProjectLocation {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ProjectLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectLocation[] @relation("LocationTree")
  kind      LocationKind      @default(ZONE)
  name      String
  sortOrder Int               @default(0)

  tasks   Task[]
  remarks Remark[]
  zones   DrawingZone[]

  @@index([projectId])
}

model Task {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id])
  /// Sequential number per company (T-145).
  number          Int
  parentId        String?
  parent          Task?            @relation("SubTasks", fields: [parentId], references: [id])
  subtasks        Task[]           @relation("SubTasks")
  title           String
  description     String?
  workTypeId      String?
  workType        WorkType?        @relation(fields: [workTypeId], references: [id])
  locationId      String?
  location        ProjectLocation? @relation(fields: [locationId], references: [id])
  unit            String?
  plannedQty      Decimal?         @db.Decimal(14, 3)
  /// Value of this work in the estimate (UZS, net); drives weighted project progress.
  plannedValueUzs Decimal?         @db.Decimal(18, 2)
  /// Manual weight when the task has no estimate value.
  weight          Decimal?         @db.Decimal(8, 3)
  status          TaskStatus       @default(NEW)
  priority        Priority         @default(MEDIUM)
  startDate       DateTime?        @db.Date
  deadline        DateTime?        @db.Date
  actualStart     DateTime?
  actualFinish    DateTime?
  /// Self-reported progress by performers (0–100); physical progress comes from work sessions.
  reportedPercent Int?
  responsibleId   String?
  responsible     User?            @relation("TaskResponsible", fields: [responsibleId], references: [id])
  inspectorId     String?
  inspector       User?            @relation("TaskInspector", fields: [inspectorId], references: [id])
  approverId      String?
  approver        User?            @relation("TaskApprover", fields: [approverId], references: [id])
  /// Users allowed to record work sessions (set by the task owner / admin / manager).
  recorderUserIds String[]
  createdById     String?
  createdBy       User?            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  bomItemId       String?
  bomItem         BomItem?         @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  importId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignments TaskAssignment[]
  events      TaskEvent[]
  sessions    WorkSession[]
  inspections Inspection[]
  remarks     Remark[]
  materials   StockMovement[]
  zoneLinks   DrawingZoneTask[]

  @@unique([companyId, number])
  @@index([projectId, status])
  @@index([deadline])
}

/// Who performs a task: an employee, a group or an external contractor (outsource).
model TaskAssignment {
  id           String       @id @default(cuid())
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind         AssigneeKind
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  groupId      String?
  group        WorkGroup?   @relation(fields: [groupId], references: [id])
  contractorId String?
  contractor   Contractor?  @relation(fields: [contractorId], references: [id])
  plannedQty   Decimal?     @db.Decimal(14, 3)
  note         String?

  // ---- outsource (contractor) terms ----
  contactName     String?
  contactPhone    String?
  plannedCostUzs  Decimal?         @db.Decimal(18, 2)
  agreedAmount    Decimal?         @db.Decimal(18, 2)
  currency        Currency         @default(UZS)
  fxRate          Decimal?         @db.Decimal(14, 4)
  fxDate          DateTime?        @db.Date
  fxSource        String?
  agreedUzs       Decimal?         @db.Decimal(18, 2)
  agreedUsd       Decimal?         @db.Decimal(18, 2)
  actualUzs       Decimal?         @db.Decimal(18, 2)
  actualUsd       Decimal?         @db.Decimal(18, 2)
  vatRate         Decimal          @default(0) @db.Decimal(5, 2)
  outsourceStatus OutsourceStatus?
  startDate       DateTime?        @db.Date
  deadline        DateTime?        @db.Date
  completedQty    Decimal?         @db.Decimal(14, 3)
  completedAt     DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  /// 1–5, given when the work is verified.
  qualityScore    Int?
  /// How many times the work was sent back for rework (feeds rating / reliability).
  reworkCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions WorkSession[]
  payments ContractorPayment[]

  @@index([taskId])
  @@index([contractorId])
}

model TaskEvent {
  id         String        @id @default(cuid())
  taskId     String
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type       TaskEventType
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee?     @relation(fields: [employeeId], references: [id])
  percent    Int?
  note       String?
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  at         DateTime      @default(now())

  @@index([taskId, at])
  @@index([employeeId, at])
}

/// One block of work on a task by a group (or individual / contractor) on a day.
/// The physical quantity is recorded here exactly once.
model WorkSession {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id])
  taskId       String
  task         Task               @relation(fields: [taskId], references: [id])
  groupId      String?
  group        WorkGroup?         @relation(fields: [groupId], references: [id])
  assignmentId String?
  assignment   TaskAssignment?    @relation(fields: [assignmentId], references: [id])
  leaderId     String?
  leader       Employee?          @relation("SessionLeader", fields: [leaderId], references: [id])
  date         DateTime           @db.Date
  startTime    DateTime?
  endTime      DateTime?
  hours        Decimal            @default(8) @db.Decimal(5, 2)
  quantity     Decimal            @default(0) @db.Decimal(14, 3)
  unit         String?
  note         String?
  problems     String?
  method       ContributionMethod @default(EQUAL)
  status       SessionStatus      @default(SUBMITTED)
  recordedById String?
  recordedBy   User?              @relation("SessionRecordedBy", fields: [recordedById], references: [id])
  approvedById String?
  approvedBy   User?              @relation("SessionApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectReason String?
  /// Frozen at approval: sum of members' hours x hourly cost.
  laborCostUzs Decimal            @default(0) @db.Decimal(18, 2)
  laborCostUsd Decimal            @default(0) @db.Decimal(18, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members   WorkSessionMember[]
  materials StockMovement[]

  @@index([companyId, date])
  @@index([taskId, date])
  @@index([projectId, date])
}

/// Individual participation in a session. Share and contribution are frozen when the session is recorded,
/// so later formula changes never rewrite history. Contribution is for KPI only (never added to project volume).
model WorkSessionMember {
  id              String       @id @default(cuid())
  sessionId       String
  session         WorkSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id])
  role            GroupRole    @default(WORKER)
  hours           Decimal      @db.Decimal(5, 2)
  sharePercent    Decimal      @db.Decimal(7, 4)
  contributionQty Decimal      @db.Decimal(14, 3)
  /// Part of `hours` above the daily norm (paid with Company.overtimeMultiplier).
  overtimeHours   Decimal      @default(0) @db.Decimal(5, 2)
  hourlyCostUzs   Decimal      @default(0) @db.Decimal(18, 2)
  laborCostUzs    Decimal      @default(0) @db.Decimal(18, 2)
  confirmation    Confirmation @default(PENDING)
  confirmedAt     DateTime?
  note            String?

  @@unique([sessionId, employeeId])
  @@index([employeeId])
}

model Inspection {
  id          String           @id @default(cuid())
  taskId      String
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt     Int
  inspectorId String?
  inspector   User?            @relation(fields: [inspectorId], references: [id])
  result      InspectionResult
  note        String?
  at          DateTime         @default(now())

  remarks Remark[]

  @@index([taskId])
}

/// A defect / remark with its own workflow; may be pinned to a drawing.
model Remark {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id])
  number            Int
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  locationId        String?
  location          ProjectLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inspectionId      String?
  inspection        Inspection?      @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  drawingVersionId  String?
  drawingVersion    DrawingVersion?  @relation(fields: [drawingVersionId], references: [id], onDelete: SetNull)
  drawingPage       Int?
  posX              Float?
  posY              Float?
  description       String
  priority          Priority         @default(MEDIUM)
  status            RemarkStatus     @default(NEW)
  responsibleUserId String?
  responsible       User?            @relation("RemarkResponsible", fields: [responsibleUserId], references: [id])
  deadline          DateTime?        @db.Date
  createdById       String?
  createdBy         User?            @relation("RemarkCreatedBy", fields: [createdById], references: [id])
  fixedAt           DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companyId, number])
  @@index([projectId, status])
}

/// One record per employee per day. Worked days include object work, workshop, travel and idle days
/// that are not the worker's fault; ABSENT / LEAVE / SICK are not worked days.
model AttendanceDay {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id])
  date         DateTime       @db.Date
  type         AttendanceType
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  hours        Decimal?       @db.Decimal(5, 2)
  note         String?
  /// SESSION (derived from a work session), ACTIVITY (worker pressed start) or MANUAL
  source       String         @default("MANUAL")
  recordedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([employeeId, date])
  @@index([companyId, date])
}

model PayrollMonth {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  month      String // YYYY-MM
  status     PayrollStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime      @default(now())

  lines PayrollLine[]

  @@unique([companyId, month])
}

/// Estimated monthly labour cost per employee (management accounting, not official payroll).
model PayrollLine {
  id              String       @id @default(cuid())
  monthId         String
  month           PayrollMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id])
  salary          Decimal      @db.Decimal(18, 2)
  normDays        Int
  workedDays      Int
  dailyRateUzs    Decimal      @db.Decimal(18, 2)
  earnedUzs       Decimal      @db.Decimal(18, 2)
  employerCostUzs Decimal      @db.Decimal(18, 2)
  allocatedUzs    Decimal      @db.Decimal(18, 2)
  unallocatedUzs  Decimal      @db.Decimal(18, 2)
}

/// Estimate (BOQ) imported from Excel; rows are reviewed and approved by an admin before anything is created.
model SmetaImport {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  fileId       String
  file         FileObject   @relation(fields: [fileId], references: [id])
  status       ImportStatus @default(DRAFT)
  /// Parsed rows: [{row, name, unit, qty, unitPrice, total, kind: TASK|EQUIPMENT|MATERIAL|SKIP, ...}]
  rows         Json
  currency     Currency     @default(UZS)
  vatRate      Decimal      @default(0) @db.Decimal(5, 2)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
}

// =====================================================================================
// Contractors (external masters, brigades, subcontractor firms)
// =====================================================================================

model Contractor {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  number          Int
  kind            ContractorKind @default(INDIVIDUAL)
  name            String
  phone           String?
  phone2          String?
  email           String?
  address         String?
  specializations String[]
  regions         String[]
  tin             String?
  bankDetails     String?
  note            String?
  active          Boolean        @default(true)
  availability    Availability   @default(AVAILABLE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  contacts     ContractorContact[]
  assignments  TaskAssignment[]
  payments     ContractorPayment[]
  scores       ContractorScore[]
  documents    Document[]
  kpiSnapshots KpiSnapshot[]

  @@unique([companyId, number])
  @@index([companyId, name])
}

model ContractorContact {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  role         String?
}

model ContractorPayment {
  id           String          @id @default(cuid())
  contractorId String
  contractor   Contractor      @relation(fields: [contractorId], references: [id])
  assignmentId String?
  assignment   TaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id])
  date         DateTime        @db.Date
  method       PaymentMethod   @default(CASH)
  reference    String?
  note         String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)

  approval     ApprovalStatus @default(APPROVED)
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([contractorId, date])
}

/// History of computed rating / reliability (snapshot after each verified job).
model ContractorScore {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  at           DateTime   @default(now())
  rating       Decimal    @db.Decimal(4, 2)
  reliability  Decimal    @db.Decimal(5, 2)
  components   Json
}

// =====================================================================================
// KPI (versioned rules, monthly snapshots with drill-down sources)
// =====================================================================================

model KpiRule {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  subject       KpiSubject    @default(EMPLOYEE)
  name          String
  version       Int
  effectiveFrom DateTime      @db.Date
  effectiveTo   DateTime?     @db.Date
  /// [{key, weight, params?}] — component keys are implemented in src/server/kpi/components.ts
  components    Json
  status        KpiRuleStatus @default(DRAFT)
  createdById   String?
  createdAt     DateTime      @default(now())

  periods KpiPeriod[]

  @@unique([companyId, subject, version])
}

model KpiPeriod {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  month        String // YYYY-MM
  subject      KpiSubject
  ruleId       String
  rule         KpiRule         @relation(fields: [ruleId], references: [id])
  status       KpiPeriodStatus @default(CALCULATED)
  calculatedAt DateTime        @default(now())
  approvedById String?
  approvedAt   DateTime?

  snapshots KpiSnapshot[]

  @@unique([companyId, month, subject])
}

model KpiSnapshot {
  id           String      @id @default(cuid())
  periodId     String
  period       KpiPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  groupId      String?
  group        WorkGroup?  @relation(fields: [groupId], references: [id])
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  score        Decimal     @db.Decimal(6, 2)
  /// Bonus fixed at approval (employees): % of the salary and the amount in the salary's terms (net/gross as entered).
  bonusPct     Decimal?    @db.Decimal(6, 2)
  bonusUzs     Decimal?    @db.Decimal(18, 2)
  /// [{key, value, weight, weighted, raw, sources: [{type, id}]}]
  components   Json
  createdAt    DateTime    @default(now())

  @@index([periodId])
}

// =====================================================================================
// Drawings / visual progress (PDF first; DWG/IFC later)
// =====================================================================================

model Drawing {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  title      String
  discipline String?
  createdAt  DateTime @default(now())

  versions DrawingVersion[]

  @@index([projectId])
}

model DrawingVersion {
  id          String     @id @default(cuid())
  drawingId   String
  drawing     Drawing    @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  version     Int
  fileId      String
  file        FileObject @relation(fields: [fileId], references: [id])
  pageCount   Int        @default(1)
  note        String?
  /// Set when zones were carried over from the previous version and need review.
  needsReview Boolean    @default(false)
  createdById String?
  createdAt   DateTime   @default(now())

  zones   DrawingZone[]
  remarks Remark[]

  @@unique([drawingId, version])
}

/// Geometry is stored in page-relative coordinates (0..1) so it survives zoom and rendering size.
model DrawingZone {
  id          String           @id @default(cuid())
  versionId   String
  version     DrawingVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page        Int
  name        String
  kind        ZoneKind
  geometry    Json
  locationId  String?
  location    ProjectLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  needsReview Boolean          @default(false)
  createdById String?
  createdAt   DateTime         @default(now())

  tasks DrawingZoneTask[]

  @@index([versionId, page])
}

model DrawingZoneTask {
  zoneId String
  zone   DrawingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  taskId String
  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([zoneId, taskId])
}

// =====================================================================================
// Warranty & service
// =====================================================================================

model ServiceContract {
  id               String                @id @default(cuid())
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id])
  clientId         String
  client           Client                @relation(fields: [clientId], references: [id])
  projectId        String?
  project          Project?              @relation(fields: [projectId], references: [id])
  number           String
  startDate        DateTime              @db.Date
  endDate          DateTime              @db.Date
  frequency        ServiceFrequency      @default(MONTHLY)
  slaResponseHours Int?
  slaResolveHours  Int?
  slaText          String?
  /// SLA hours count only working time (Mon–Sat 09:00–18:00 Tashkent) instead of calendar hours (M11).
  slaBusinessHours Boolean               @default(false)
  status           ServiceContractStatus @default(ACTIVE)
  note             String?

  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  fxRate    Decimal  @db.Decimal(14, 4)
  fxDate    DateTime @db.Date
  fxSource  String   @default("CBU")
  amountUzs Decimal  @db.Decimal(18, 2)
  amountUsd Decimal  @db.Decimal(18, 2)
  vatRate   Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets ServiceTicket[]

  @@index([companyId, endDate])
}

model ServiceTicket {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id])
  number            Int
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id])
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id])
  serviceContractId String?
  serviceContract   ServiceContract?    @relation(fields: [serviceContractId], references: [id])
  siteAddress       String?
  title             String
  problem           String
  diagnosis         String?
  solution          String?
  priority          Priority            @default(MEDIUM)
  status            ServiceTicketStatus @default(NEW)
  /// Within warranty: costs are ours, nothing is billed.
  isWarranty        Boolean             @default(false)
  responsibleUserId String?
  responsible       User?               @relation(fields: [responsibleUserId], references: [id])
  /// Planned maintenance visit created from a service contract schedule.
  planned           Boolean             @default(false)
  reportedAt        DateTime            @default(now())
  /// First reaction (assigned / work started) — for the SLA response time.
  respondedAt       DateTime?
  dueAt             DateTime?
  resolvedAt        DateTime?
  laborHours        Decimal?            @db.Decimal(6, 2)
  laborCostUzs      Decimal             @default(0) @db.Decimal(18, 2)
  otherCostUzs      Decimal             @default(0) @db.Decimal(18, 2)
  chargeUzs         Decimal             @default(0) @db.Decimal(18, 2)
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  parts StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

/// Failed sign-in attempts per key ("id:<identifier>" or "ip:<address>") for brute-force protection.
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  firstAt     DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Cache of AI translations of user-entered texts (source text hash + target locale).
model TextTranslation {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hash      String
  locale    String
  text      String
  provider  String
  createdAt DateTime @default(now())

  @@unique([companyId, hash, locale])
}
